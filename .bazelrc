# Control console output
test --test_output=errors

# The flags a plain `bazel build //...` gets, which is the configuration
# `bazel test //...` runs the suite in. The build types the Makefile exposes are
# configs below: `make release` is this one, and `make relassert`, `make reldebug`
# and `make debug` add `--config=`.
common --check_direct_dependencies=error
common --worker_max_instances=auto

# Once per build: the checkout's commit and version, handed to rules through
# ctx.info_file. The engine reads them from a generated header rather than the
# command line, where they would land in every compile action's defines. Only a
# stamped build reads this file; see --//:stamp_version below.
common --workspace_status_command=scripts/workspace_status.sh

# Off by default, so committing re-runs nothing: the value can only reach a
# binary through a relink, and that relinks all 226 test executables, which then
# all re-run. Unstamped the header carries fixed placeholders that satisfy every
# assertion in the suite. `build --//:stamp_version` for a build whose binaries
# name the commit they came from.
build --//:stamp_version=false

# The tests reach outside their runfiles (a temp dir under the checkout, a fixed
# socket) in ways the sandbox does not model, so they run unsandboxed.
test --spawn_strategy=local

# Disk cache shared between multiple checkouts of this repository (worktrees)
common --disk_cache=/tmp/duckdb/bazel/diskcache

# opt is the default rather than a config because a -O0 build does not fit the stack
# on test/ossfuzz case 49 (SIGILL), so the suite only passes in the release
# configuration. Bazel's own opt flags carry -O2 -DNDEBUG; the rest is what the
# project's sources expect on top of them.
common --compilation_mode=opt
build --cxxopt=-std=c++17
build --cxxopt=-Wthread-safety
build --cxxopt=-mcpu=apple-m1

# `make relassert`: the release configuration with assertions live, which is what
# src/include/duckdb/common/assert.hpp switches on.
build:relassert --//:force_assert=true

# `make reldebug`: optimized, but the symbols stay in the binary.
build:reldebug --strip=never
build:reldebug -c opt
build:reldebug --copt=-g

# `make debug`: Bazel's dbg is -O0 -g -DDEBUG, which is the same shape as the
# debug build the suite has always been developed against.
build:debug -c dbg

# `make unittest_threadsan`: the release configuration built with the thread
# sanitizer. The suppression file it passes is referenced from the workflow.
build:threadsan -c opt
build:threadsan --copt=-fsanitize=thread
build:threadsan --linkopt=-fsanitize=thread

# Rust formatting: enable rustfmt_aspect for build-time format checking
# This makes `bazel build //...` fail if any Rust code is incorrectly formatted
build --aspects=@rules_rust//rust:defs.bzl%rustfmt_aspect
build --output_groups=+rustfmt_checks
build --@rules_rust//rust/settings:rustfmt.toml=//:rustfmt.toml

# Rust linter
build --aspects=@rules_rust//rust:defs.bzl%rust_clippy_aspect
build --output_groups=+clippy_checks
build --@rules_rust//rust/settings:clippy.toml=//:clippy.toml

try-import %workspace%/.bazelrc.user
