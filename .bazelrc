# Mirrors of the flags the CMake configure puts on the command line. aquery must be
# run with --config=macos so both sides of the parity diff see the same toolchain.
common --check_direct_dependencies=error

# Once per build: the checkout's commit and version, handed to rules through
# ctx.info_file. The engine reads them from a generated header rather than the
# command line, where they would land in every compile action's defines.
common --workspace_status_command=scripts/workspace_status.sh

# The tests reach outside their runfiles (a temp dir under the checkout, a fixed
# socket) in ways the sandbox does not model, so they run unsandboxed like the
# CMake build does.
test --spawn_strategy=local

# CMake Release: -O3 -DNDEBUG; CMAKE_CXX_STANDARD=17; the project adds
# -Wthread-safety; -mcpu comes from CMake's native-arch detection on Apple Silicon.
build --copt=-DNDEBUG
build --cxxopt=-std=c++17
build --cxxopt=-Wthread-safety
build --cxxopt=-mcpu=apple-m1

# With non-optimized build we encounter stack exhaustion in some test.
common --compilation_mode=opt
