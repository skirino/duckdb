"""Repository rule providing Crubit's C++ bindings generator.

Crubit has Bazel rules of its own (`@rules_crubit`, `cc_bindings_from_rust`),
but they are not published to the Bazel Central Registry, are registered for
Linux only (crubit's common/bazel_support/toolchains/BUILD has one platform in
_PROD_PLATFORMS), and build LLVM 23 from sources to run -- see
rust/crubit_bindings.bzl. This instead builds the generator Crubit's own CMake
integration drives, `cargo cpp_api_from_rust`, and hands the bindings rule a
plain executable, so the bindings can be produced wherever Rust runs.

Pinned per generation in MODULE.bazel. To bump Crubit, change `commit`,
`url` and `sha256` together, and check `nightly` against the `rust_version` in
Crubit's own MODULE.bazel: the generator compiles against rustc internals, so a
newer rustc renames them out from under it.

What this repository exposes:

    :cpp_api_from_rust     the generator executable
    :support_headers       the headers the generated bindings include, which
                           they spell `#include <support/bridge.h>`
    :support_runtime       the part of Crubit's C++ runtime the generated
                           bindings need at link time
    :cargo, :rustc         the pinned toolchain's cargo and rustc

The headers are copied rather than referenced where they sit in Crubit's
checkout because Bazel does not glob into a directory holding a BUILD file and
Crubit's tree is full of them; the copy is the only tree here Bazel reads as a
single package. The generator reads its own checkout directly for everything
else, which //bazel:crubit_bindings.bzl documents.
"""

CRUBIT_URL_FORMAT = "https://github.com/google/crubit/archive/%s.tar.gz"

BUILD_FILE = '''\
# Generated by //bazel:crubit_toolchain.bzl -- do not edit.
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# `cargo cpp_api_from_rust`, the generator Crubit's CMake integration also drives.
filegroup(
    name = "cpp_api_from_rust",
    srcs = ["cargo-cpp_api_from_rust"],
)

# The pinned toolchain's cargo and rustc. The generator runs cargo, which runs
# rustc, and the generator links its own toolchain's shared libraries by @rpath --
# so the compiler building the crate has to come from that toolchain too.
exports_files(["cargo", "rustc"])

# Crubit's sources under `crubit/` keep their own BUILD files, which load
# Crubit's own Bazel dependencies and cannot be resolved here, so this repository
# is addressed by label and never with `//...`.

# Crubit's `support/` directory with only the headers copied into it, which is
# what makes it one package Bazel can glob.
cc_library(
    name = "support_headers",
    hdrs = glob(["crubit_headers/**/*.h"]),
    includes = ["crubit_headers"],
)

# The part of Crubit's C++ runtime the generated bindings need at link time. It is
# separate from the headers because it is the only piece with sources, and because
# it is a dependency of the generated staticlib rather than of the headers that
# include it.
cc_library(
    name = "support_runtime",
    srcs = [
        "crubit_headers/support/internal/check_no_mutable_aliasing.cc",
        "crubit_headers/support/rs_std/waker.cc",
    ],
    hdrs = [
        "crubit_headers/support/internal/check.h",
        "crubit_headers/support/internal/check_no_mutable_aliasing.h",
        "crubit_headers/support/rs_std/waker.h",
    ],
    # The aliasing check is C++20 (<span>, designated initializers) where the
    # rest of this build is C++17, and rule copts come after --cxxopt.
    copts = ["-std=c++20"],
    includes = ["crubit_headers"],
)

# The same headers as plain files, for //bazel:crubit_bindings.bzl to copy into the
# include root it writes.
filegroup(
    name = "support_headers_files",
    srcs = glob(["crubit_headers/**/*.h"]),
)

'''

TOOLCHAIN_FILE = '''\
[toolchain]
channel = "{nightly}"
components = ["rustc-dev", "llvm-tools", "rust-src", "rustfmt"]
'''

# Extracted under `crubit_headers/support/` because the generated bindings spell
# these `#include <support/bridge.h>` and `#include <support/rs_std/option.h>`:
# `support` is part of the path, not the include root. The wrapper directory is
# what //bazel:crubit_bindings.bzl strips to lay the tree out again, so nothing
# else may be placed beside it.
#
# Two more files come along as well. The generated bindings' use of
# `rs_std::Vec` and friends reaches the Rust `crubit_support` crate, and the
# codegen unit holding `crubit_alloc` also holds `dyn_erased_future`'s
# implementations, which call the four functions `waker.cc` defines. The
# bindings' mutable-argument aliasing checks reach `CheckNoMutableAliasingSpans`
# whenever a call passes more than three pointers, which is out of line in
# `check_no_mutable_aliasing.cc`. Which of Crubit's C++ runtime sources a link
# needs therefore depends on where the generator happened to put them, so those
# files are copied whole here and the list is re-checked against the next
# release, rather than being spelled out as a part-by-part recipe of what this
# one happened to need.
_COPY_SOURCES = """
  mkdir -p '{repo}/crubit_headers/support/rs_std' '{repo}/crubit_headers/support/internal' &&
  cp '{support}/rs_std/waker.cc' '{repo}/crubit_headers/support/rs_std/' &&
  cp '{support}/internal/check_no_mutable_aliasing.cc' '{repo}/crubit_headers/support/internal/'
"""
_COPY_HEADERS = """
  cd '{support}' &&
  find . -name '*.h' -print | tar cf - -T - |
    (mkdir -p '{repo}/crubit_headers/support' &&
     cd '{repo}/crubit_headers/support' && tar xf -) &&
""" + _COPY_SOURCES

# The generator links against the Rust nightly's own shared libraries by @rpath,
# with no rpath recorded, so the loader has to be told where they are. They are
# symlinked next to the generator rather than copied: librustc_driver is 90 MB and
# libLLVM 140 MB. rustup's toolchain directory keeps them under versioned names,
# which is why this is a glob rather than a pair of known files.
#
# The toolchain's cargo and rustc are linked alongside for the same reason: the
# generator runs cargo, and on macOS a loader path wide enough for the generator's
# librustc_driver also captures the rustc that cargo runs, so both have to come
# from the same toolchain.
_LINK_TOOLCHAIN = """
  cd '{repo}' || exit 1
  for lib in '{sysroot}'/lib/*.dylib '{sysroot}'/lib/*.so; do
    [ -e "$lib" ] && ln -sf "$lib" .
  done
  for tool in cargo rustc; do
    ln -sf '{sysroot}'/bin/$tool $tool
  done
"""


def _crubit_toolchain_repository_impl(repository_ctx):
    commit = repository_ctx.attr.commit
    repo = repository_ctx.path(".")
    source = repository_ctx.path("crubit")
    support = repository_ctx.path("crubit/support")

    repository_ctx.download_and_extract(
        url = repository_ctx.attr.url or CRUBIT_URL_FORMAT % commit,
        sha256 = repository_ctx.attr.sha256,
        strip_prefix = "crubit-%s" % commit,
        output = "crubit",
    )

    # The generator compiles Rust code against rustc internals, so the nightly it
    # is built with is an input to the build rather than a fact about the machine.
    # Crubit ships `channel = "nightly"`, which tracks whatever is newest and
    # breaks the moment upstream renames one of those internals. rustup installs
    # the pinned toolchain and its components on first use.
    repository_ctx.file(
        "crubit/rust-toolchain.toml",
        TOOLCHAIN_FILE.format(nightly = repository_ctx.attr.nightly),
    )

    cargo = repository_ctx.which("cargo")
    if not cargo:
        fail("cargo is not on PATH; install Rust with rustup (https://rustup.rs) so " +
             "the Crubit bindings generator can be built")

    # `--locked`, so the generator is built from Crubit's checked-in lockfile
    # rather than from whatever resolves today.
    result = repository_ctx.execute(
        [
            "/bin/sh",
            "-c",
            "cd '%s' && exec '%s' build --release --locked -p cargo-cpp_api_from_rust" %
            (source, cargo),
        ],
        timeout = 3600,
    )
    if result.return_code != 0:
        fail("failed to build cargo-cpp_api_from_rust:\n%s" % result.stderr)

    sysroot = repository_ctx.execute(
        ["/bin/sh", "-c", "cd '%s' && exec rustc --print sysroot" % source],
    ).stdout.strip()

    repository_ctx.execute([
        "/bin/sh",
        "-c",
        _COPY_HEADERS.format(support = support, repo = repo) +
        _LINK_TOOLCHAIN.format(sysroot = sysroot, repo = repo),
    ])
    repository_ctx.symlink(
        "crubit/target/release/cargo-cpp_api_from_rust",
        "cargo-cpp_api_from_rust",
    )
    repository_ctx.file("BUILD.bazel", BUILD_FILE)


crubit_toolchain_repository = repository_rule(
    implementation = _crubit_toolchain_repository_impl,
    attrs = {
        "commit": attr.string(mandatory = True),
        "nightly": attr.string(
            mandatory = True,
            doc = "The Rust nightly the generator is built with.",
        ),
        "sha256": attr.string(mandatory = True),
        "url": attr.string(doc = "Defaults to the GitHub archive of `commit`."),
    },
    doc = "Builds Crubit's `cargo cpp_api_from_rust` bindings generator.",
)
