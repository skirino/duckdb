# name: test/sql/copy/csv/glob/read_csv_glob_crawl.test_slow
# description: Test glob **
# group: [glob]

# tests without previous directories
# files from: '{DATA_DIR}/csv/glob/crawl/' -- a bare '**' crawls the working
# directory, whose entries are all symlinks under Bazel runfiles and are skipped
query I
select count(*) > 0 from glob('{DATA_DIR}/csv/glob/crawl/**');
----
true

query I
select count(*) from glob('{DATA_DIR}/csv/glob/crawl/**/samename/*');
----
8
