"""Bazel build for DuckDB.

The sources divide into a handful of distinct (defines, includes, flags)
profiles, so each profile is one cc_library here rather than one per directory.
The shared parts of a profile live in duckdb_build_config.bzl, and a target
states only where it differs.

Toolchain-level flags (-std, -Wthread-safety, -mcpu) live in .bazelrc, and the
four build types (release, relassert, reldebug, debug) are configs there.
"""

load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library", "cc_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel:duckdb_build_config.bzl", "DUCKDB_DEFINES", "DUCKDB_INCLUDES",
      "DUCKDB_LIB_DEPS", "DUCKDB_TEST_INCLUDES", "duckdb_library",
      "duckdb_rust_bridge_library")
load("//bazel:duckdb_codegen.bzl", "extension_codegen_files", "fixture_tree",
      "version_info_header")
load("//bazel:duckdb_test.bzl", "FIXTURE_TREES", "TEST_DATA_GLOBS",
      "TEST_DATA_GLOBS_WITHOUT_FIXTURES")

exports_files([
    "rustfmt.toml",
    "clippy.toml",
])

# --- configure_file() equivalents -------------------------------------------

extension_codegen_files(
    name = "generated_extension_codegen",
    extensions = [
        "autocomplete",
        "core_functions",
        "icu",
        "json",
        "parquet",
        "tpcds",
        "tpch",
    ],
    header_out = "generated_extension_headers.hpp",
    loader_out = "generated_extension_loader.cpp",
)

filegroup(
    name = "generated_extension_headers_files",
    srcs = [":generated_extension_codegen"],
    output_group = "generated_extension_headers",
)

filegroup(
    name = "generated_extension_loader_files",
    srcs = [":generated_extension_codegen"],
    output_group = "generated_extension_loader",
)

cc_library(
    name = "generated_extension_headers",
    hdrs = [":generated_extension_headers_files"],
    # One <name>_extension.hpp per statically linked extension, so the include
    # roots of those extensions are what the generated header needs to be
    # found through. Listed here rather than in DUCKDB_INCLUDES so that adding
    # an extension does not restate them for every translation unit.
    includes = [
        "codegen",
        "extension/autocomplete/include",
        "extension/core_functions/include",
        "extension/icu/include",
        "extension/json/include",
        "extension/parquet/include",
        "extension/tpcds/include",
        "extension/tpch/include",
    ],
    deps = [":duckdb_headers"],
)

duckdb_library(
    name = "generated_extension_loader",
    srcs = [":generated_extension_loader_files"],
    deps = [":duckdb_headers", ":generated_extension_headers"],
)

# --- headers ---------------------------------------------------------------

# Every header is declared once so the C++ layering check can attribute each
# inclusion to a target.
#
# `includes` carries DUCKDB_INCLUDES here rather than on every library: the
# engine include roots are all package-relative to the repo root, so a library
# in a subpackage cannot spell them. Because `includes` propagates transitively
# through `deps`, and every duckdb_library deps on this target, one declaration
# reaches the whole tree.
cc_library(
    name = "duckdb_headers",
    hdrs = glob(
        [
            "src/include/**/*.h",
            "src/include/**/*.hpp",
            "extension/**/*.h",
            "extension/**/*.hpp",
            "third_party/**/*.h",
            "third_party/**/*.hpp",
            "third_party/**/*.tcc",
            "tools/**/*.h",
            "tools/**/*.hpp",
        ],
    ),
    includes = DUCKDB_INCLUDES,
    textual_hdrs = [
        "third_party/utf8proc/utf8proc_data.cpp",
    ],
)

# The test include roots, same reasoning as duckdb_headers' `includes`: a test
# library under test/ cannot spell "third_party/catch" or "test/include", but it
# deps on this target and gets them transitively.
cc_library(
    name = "duckdb_test_include_paths",
    includes = DUCKDB_TEST_INCLUDES,
)

# --- one library per compile profile ----------------------------------------

duckdb_library(
    name = "duckdb_catalog",
    srcs = glob(["src/catalog/*.cpp"]),
    local_defines = DUCKDB_DEFINES + ["DISABLE_CORE_FUNCTIONS_EXTENSION=1"],
)

duckdb_library(
    name = "duckdb_main_extension",
    srcs = glob(["src/main/extension/*.cpp"]),
    local_defines = DUCKDB_DEFINES + ["DUCKDB_EXTENSION_DIRECTORIES=\\\"~/.duckdb/extensions\\\""],
)

duckdb_library(
    name = "duckdb_common_http",
    srcs = glob(["src/main/http/*.cpp"]),
    # http_util.cpp calls HTTPUtil::ToStatusCode / GetStatusMessage, which
    # src/common/enums/http_status_code.cpp defines in //:duckdb_enums.
    deps = DUCKDB_LIB_DEPS + [":duckdb_enums"],
)

duckdb_library(
    name = "duckdb_func_table_version",
    srcs = [
        "src/function/table/version/pragma_version.cpp",
        ":generated_version_info",
    ],
    local_defines = DUCKDB_DEFINES + ["DUCKDB_VERSION_INFO_HEADER=1"],
)

duckdb_library(
    name = "duckdb_core",
    srcs = glob(
        [
            "src/catalog/catalog_entry/**/*.cpp",
            "src/catalog/default/**/*.cpp",
            "src/common/**/*.cpp",
            "src/execution/**/*.cpp",
            "src/function/**/*.cpp",
            "src/main/**/*.cpp",
            "src/optimizer/**/*.cpp",
            "src/parallel/**/*.cpp",
            "src/parser/**/*.cpp",
            "src/planner/**/*.cpp",
            "src/storage/**/*.cpp",
            "src/transaction/**/*.cpp",
        ],
        exclude = [
            "src/common/allocator/allocator.cpp",
            # The bridge includes crubit/ahirudb.h, which needs C++20; it belongs
            # to //:duckdb_allocator, which compiles with crubit_copts().
            "src/common/allocator/allocator_rust_bridge.cpp",
            "src/common/allocator/allocator_jemalloc.cpp",
            "src/common/allocator/allocator_standard.cpp",
            # src/common/vector has a target of its own, below.
            "src/common/vector/**/*.cpp",
            # src/common/exception has a target of its own.
            "src/common/exception.cpp",
            "src/common/exception/**/*.cpp",
            # src/common/enums has a target of its own.
            "src/common/enums/**/*.cpp",
            # src/common/multi_file has a target of its own, below.
            "src/common/multi_file/**/*.cpp",
            # src/common/row_operations has a target of its own.
            "src/common/row_operations/**/*.cpp",
            # src/common/serializer has a target of its own.
            "src/common/serializer/**/*.cpp",
            # src/common/types/row has a target of its own.
            "src/common/types/row/**/*.cpp",
            "src/function/table/version/pragma_version.cpp",
            "src/main/extension/extension_alias.cpp",
            "src/main/extension/extension_helper.cpp",
            "src/main/extension/extension_install.cpp",
            "src/main/extension/extension_load.cpp",
            "src/main/extension/extension_loader.cpp",
            "src/main/extension/extension_repository_manager.cpp",
            "src/main/http/http_client_pool.cpp",
            "src/main/http/http_retry_budget.cpp",
            "src/main/http/http_transport_config.cpp",
            "src/main/http/http_transport_manager.cpp",
            "src/main/http/http_util.cpp",
        ],
    ),
    # duckdb_library's `deps` replaces the default rather than extending it.
    deps = DUCKDB_LIB_DEPS + [":duckdb_exception", ":duckdb_allocator", ":duckdb_enums", ":duckdb_row_operations", ":duckdb_serializer"],
)

# src/logging is a library of its own because it is the one that calls into the ahirudb crate: log_rust_bridge.cpp
# includes crubit/ahirudb.h and calls the Rust logging implementation through it.
duckdb_rust_bridge_library(
    name = "duckdb_logging",
    srcs = glob(["src/logging/**/*.cpp"]),
    hdrs = ["src/logging/log_rust_bridge.hpp"],
    include_root = "src/logging",
)

# src/common/vector is a library of its own for the same reason as src/logging: the buffer classes reach the Rust vector
# module in `ahirudb` for their selection-vector and validity-mask arithmetic, and vector_rust_bridge.cpp includes
# crubit/ahirudb.h to do it.
duckdb_rust_bridge_library(
    name = "duckdb_vector",
    srcs = glob(["src/common/vector/**/*.cpp"]),
    hdrs = ["src/common/vector/vector_rust_bridge.hpp"],
    include_root = "src/common/vector",
)

# src/common/exception is a library of its own for the same reason as src/logging: the exception classes and their
# factories reach the Rust exception module in `ahirudb` for the type names, the classification and the messages they
# build, and exception_rust_bridge.cpp includes crubit/ahirudb.h to do it.
duckdb_rust_bridge_library(
    name = "duckdb_exception",
    srcs = ["src/common/exception.cpp"] + glob(["src/common/exception/**/*.cpp"]),
    hdrs = ["src/common/exception/exception_rust_bridge.hpp"],
    include_root = "src/common/exception",
)

# src/common/allocator is a library of its own for the same reason as duckdb_exception/duckdb_vector: allocator.cpp's
# debug info shells out to the Rust allocator module, and allocator_rust_bridge.cpp includes crubit/ahirudb.h.
duckdb_rust_bridge_library(
    name = "duckdb_allocator",
    srcs = [
        "src/common/allocator/allocator.cpp",
        "src/common/allocator/allocator_rust_bridge.cpp",
    ] + select({
        ":jemalloc_enabled": [],
        "//conditions:default": ["src/common/allocator/allocator_standard.cpp"],
    }),
    hdrs = ["src/common/allocator/allocator_rust_bridge.hpp"],
    include_root = "src/common/allocator",
    extra_deps = [":duckdb_exception"],
)

# src/common/enums reaches the Rust enums module for the string <-> enum conversions, and enums_rust_bridge.cpp
# includes crubit/ahirudb.h to do it.
duckdb_rust_bridge_library(
    name = "duckdb_enums",
    srcs = glob(["src/common/enums/**/*.cpp"]),
    hdrs = ["src/common/enums/enums_rust_bridge.hpp"],
    include_root = "src/common/enums",
    extra_deps = [":duckdb_exception"],
)

# src/common/multi_file is a library of its own for the same reason as src/logging: multi_file_data.cpp and
# multi_file_list.cpp reach the Rust multi_file module in `ahirudb` for the rules over the multi-file reader's indices
# and file lists, and multi_file_rust_bridge.cpp includes crubit/ahirudb.h to do it.
duckdb_rust_bridge_library(
    name = "duckdb_multi_file",
    srcs = glob(["src/common/multi_file/**/*.cpp"]),
    hdrs = ["src/common/multi_file/multi_file_rust_bridge.hpp"],
    include_root = "src/common/multi_file",
)

# src/common/row_operations is a library of its own for the same reason as src/logging: row_operations_rust_bridge.cpp
# includes crubit/ahirudb.h and calls the Rust row_operations implementation through it.
duckdb_rust_bridge_library(
    name = "duckdb_row_operations",
    srcs = glob(["src/common/row_operations/**/*.cpp"]),
    hdrs = ["src/common/row_operations/row_operations_rust_bridge.hpp"],
    include_root = "src/common/row_operations",
)

# src/common/types/row: tuple_data_layout.cpp now reaches the Rust tuple_data_layout module through
# tuple_data_layout_rust_bridge.cpp, so it needs crubit copts.
duckdb_rust_bridge_library(
    name = "duckdb_types_row",
    srcs = glob(["src/common/types/row/**/*.cpp"]),
    hdrs = ["src/common/types/row/tuple_data_layout_rust_bridge.hpp"],
    include_root = "src/common/types/row",
)

# src/common/serializer reaches the Rust serializer module in `ahirudb` for the
# binary format (binary_serializer.cpp / binary_deserializer.cpp now forward
# every virtual to the Rust implementation).
duckdb_rust_bridge_library(
    name = "duckdb_serializer",
    srcs = glob(["src/common/serializer/**/*.cpp"]),
    hdrs = [],
    include_root = "src/common/serializer",
)

duckdb_library(
    name = "core_functions_extension_init",
    srcs = ["extension/core_functions/core_functions_extension.cpp"],
)

duckdb_library(
    name = "core_functions",
    srcs = glob(
        ["extension/core_functions/**/*.cpp"],
        exclude = ["extension/core_functions/core_functions_extension.cpp"],
    ),
)

duckdb_library(
    name = "parquet_extension_init",
    srcs = ["extension/parquet/parquet_extension.cpp"],
    includes = sorted(DUCKDB_INCLUDES + [
        "third_party/brotli/include",
        "third_party/lz4",
        "third_party/parquet",
        "third_party/snappy",
        "third_party/thrift",
    ]),
)

duckdb_library(
    name = "autocomplete_extension",
    srcs = glob(["extension/autocomplete/*.cpp"]),
    includes = sorted(DUCKDB_INCLUDES + ["extension/autocomplete/include"]),
)

duckdb_library(
    name = "icu_extension",
    srcs = glob(["extension/icu/**/*.cpp"]),
    includes = sorted(DUCKDB_INCLUDES + [
        "extension/icu/collation/include",
        "extension/icu/datetime/include",
        "extension/icu/include",
    ]),
)

duckdb_library(
    name = "json_extension",
    srcs = glob(["extension/json/**/*.cpp"]),
    includes = sorted(DUCKDB_INCLUDES + ["extension/json/include"]),
)

duckdb_library(
    name = "tpch_dbgen",
    srcs = glob(["extension/tpch/dbgen/*.cpp"]),
    includes = sorted(DUCKDB_INCLUDES + ["extension/tpch/dbgen/include"]),
    copts = ["-fPIC", "-w"],
)

duckdb_library(
    name = "tpch_extension",
    srcs = [
        "extension/tpch/tpch_extension.cpp",
        ":tpch_dbgen",
    ],
    includes = sorted(DUCKDB_INCLUDES + [
        "extension/tpch/dbgen/include",
        "extension/tpch/include",
    ]),
)

duckdb_library(
    name = "tpcds_dsdgen",
    srcs = glob(["extension/tpcds/dsdgen/*.cpp"]) + glob(["extension/tpcds/dsdgen/dsdgen-c/*.cpp"]),
    includes = sorted(DUCKDB_INCLUDES + [
        "extension/tpcds/dsdgen/include",
        "extension/tpcds/dsdgen/include/dsdgen-c",
    ]),
    copts = ["-fPIC", "-w"],
)

duckdb_library(
    name = "tpcds_extension",
    srcs = [
        "extension/tpcds/tpcds_extension.cpp",
        ":tpcds_dsdgen",
    ],
    includes = sorted(DUCKDB_INCLUDES + [
        "extension/tpcds/dsdgen/include",
        "extension/tpcds/include",
    ]),
)

# The demo of a C ABI extension: a loadable .duckdb_extension, built against the
# stable v1 C API, and carrying no C++ extension machinery at all. The core
# registry asks for it DONT_LINK, so it is not part of the shell -- what it is is
# a file the engine can LOAD.
#
# The C API version is one value in two places: the defines the extension compiles
# against, and the field the loader range-checks the finished file against. So it
# is spelled once, here, and split for the defines.
DEMO_CAPI_API_VERSION = "v1.5.6"
DEMO_CAPI_API_VERSION_PARTS = DEMO_CAPI_API_VERSION[1:].split(".")

duckdb_library(
    name = "parquet_extension",
    srcs = glob(
        [
            "third_party/snappy/**/*.cc",
            "extension/parquet/**/*.cpp",
            "third_party/brotli/common/**/*.cpp",
            "third_party/brotli/dec/**/*.cpp",
            "third_party/brotli/enc/**/*.cpp",
            "third_party/lz4/**/*.cpp",
            "third_party/parquet/**/*.cpp",
            "third_party/thrift/thrift/protocol/**/*.cpp",
            "third_party/thrift/thrift/transport/**/*.cpp",
        ],
        exclude = [
            "extension/parquet/parquet_extension.cpp",
            "third_party/snappy/snappy-stubs-internal.cc",
        ],
    ),
    includes = sorted(DUCKDB_INCLUDES + [
        "third_party/brotli/include",
        "third_party/lz4",
        "third_party/parquet",
        "third_party/snappy",
        "third_party/thrift",
    ]),
)

duckdb_library(
    name = "third_party_fsst",
    srcs = glob(["third_party/fsst/*.cpp"]),
    copts = ["-fPIC", "-fvisibility=hidden", "-w"],
)

duckdb_library(
    name = "third_party_mbedtls",
    srcs = glob(["third_party/mbedtls/*.cpp", "third_party/mbedtls/library/*.cpp"]),
    copts = ["-fPIC", "-fvisibility=hidden"],
)

duckdb_library(
    name = "third_party_re2",
    srcs = glob(["third_party/re2/re2/*.cc", "third_party/re2/util/*.cc"]),
    local_defines = DUCKDB_DEFINES + ["RE2_ON_VALGRIND"],
    copts = ["-fPIC", "-fvisibility=hidden", "-w"],
)

duckdb_library(
    name = "extension_loader",
    srcs = glob(
        ["third_party/utf8proc/**/*.cpp"],
        exclude = ["third_party/utf8proc/utf8proc_data.cpp"],
    ),
)

duckdb_library(
    name = "dummy_static_extension_loader",
    srcs = glob(["extension/loader/*.cpp"]),
    alwayslink = 0,
)

duckdb_library(
    name = "third_party_core",
    srcs = glob(
        [
            "third_party/fmt/*.cc",
            "third_party/fastpforlib/*.cpp",
            "third_party/hyperloglog/*.cpp",
            "third_party/miniz/*.cpp",
            "third_party/skiplist/*.cpp",
            "third_party/yyjson/*.cpp",
            "third_party/zstd/common/*.cpp",
            "third_party/zstd/compress/*.cpp",
            "third_party/zstd/decompress/*.cpp",
            "third_party/zstd/deprecated/*.cpp",
            "third_party/zstd/dict/*.cpp",
        ],
    ),
    copts = ["-fPIC", "-w"],
)

duckdb_library(
    name = "duckdb_linenoise",
    srcs = glob(["tools/shell/linenoise/*.cpp"]),
    includes = sorted(DUCKDB_INCLUDES + ["tools/shell/include", "tools/shell/linenoise/include"]),
)

duckdb_library(
    name = "duckdb_cpp_api",
    srcs = glob(["tools/cpp/*.cpp"]),
    copts = ["-fPIC", "-fvisibility-inlines-hidden", "-fvisibility=hidden"],
    includes = sorted(DUCKDB_INCLUDES + ["tools/cpp"]),
)

duckdb_library(
    name = "test_helpers",
    srcs = glob(["test/helpers/*.cpp"]),
    local_defines = DUCKDB_DEFINES + ["DUCKDB_BUILD_DIRECTORY=\\\".\\\"", "DUCKDB_ROOT_DIRECTORY=\\\".\\\""],
    includes = sorted(DUCKDB_INCLUDES + [
        "test/extension/debug_fs/include",
        "test/include",
        "third_party/catch",
        "third_party/sqlite/include",
    ]),
)

# --- link deliverables ------------------------------------------------------

cc_library(
    name = "duckdb_static",
    visibility = ["//visibility:public"],
    deps = [
        ":duckdb_catalog",
        ":duckdb_main_extension",
        ":duckdb_common_http",
        ":duckdb_func_table_version",
        ":duckdb_core",
        ":duckdb_logging",
        ":duckdb_vector",
        ":duckdb_multi_file",
        ":duckdb_exception",
        ":duckdb_allocator",
        ":duckdb_types_row",
        ":core_functions_extension_init",
        ":core_functions",
        ":parquet_extension_init",
        ":parquet_extension",
        ":autocomplete_extension",
        ":icu_extension",
        ":json_extension",
        ":tpch_extension",
        ":tpcds_extension",
        ":third_party_fsst",
        ":third_party_mbedtls",
        ":third_party_re2",
        ":extension_loader",
        ":third_party_core",
    ],
    alwayslink = 1,
)

cc_shared_library(
    name = "duckdb",
    deps = [
        ":duckdb_static",
        ":generated_extension_loader",
