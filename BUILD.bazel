        ":test_sqlite_libs",
        ":duckdb_static",
        ":duckdb_cpp_api",
        ":test_debug_fs_libs",
        ":test_static_extension_demo",
    ],
)

# CMake builds each of these as its own .duckdb_extension shared library
# (add_library(... SHARED ...) with SUFFIX .duckdb_extension) and the tests
# LOAD them by that exact path under {BUILD_DIRECTORY}/test/extension/.
# cc_shared_library keeps them library-kind on the Bazel side too, so parity
# still folds them into the library union; the genrule then places the artifact
# in the runfiles where the test looks for it.
# The loader reads the metadata footer off the end of the file, so the
# artifact needs one; CMake appends it with a POST_BUILD step.
genrule(
    name = "duckdb_platform_out",
    srcs = [":duckdb_platform_binary"],
    outs = ["duckdb_platform_out.txt"],
    cmd = "$(location :duckdb_platform_binary) > $@",
)

