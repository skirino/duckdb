# 
# An optimized build whose D_ASSERT stays live, which is `make relassert` and the
# configuration several CI jobs test. The define is read by every translation unit
# (src/include/duckdb/common/assert.hpp), so it is a select on the shared define
# list rather than a copts on the handful of targets that assert.
bool_flag(
    name = "force_assert",
    build_setting_default = False,
)

config_setting(
    name = "force_assert_enabled",
    flag_values = {"//:force_assert": "true"},
)

# The engine's own commit and version, which reach it through a header rather than
# the defines, where a new commit would rebuild the world.
bool_flag(
    name = "stamp_version",
    build_setting_default = False,
)

config_setting(
    name = "stamp_version_enabled",
    flag_values = {"//:stamp_version": "true"},
)

version_info_header(
    name = "generated_version_info",
    out = "generated_version_info.hpp",
    stamp = select({
        ":stamp_version_enabled": True,
        "//conditions:default": False,
    }),
)
