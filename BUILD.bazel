        "tools/shell/include",
        "tools/shell/linenoise/include",
    ],
    linkopts = [
        "-Wl,-search_paths_first",
        "-Wl,-headerpad_max_install_names",
    ],
    deps = [
        ":duckdb_core",
        ":duckdb_catalog",
        ":duckdb_main_extension",
        ":duckdb_common_http",
        ":duckdb_func_table_version",
        ":core_functions",
        ":core_functions_extension_init",
        ":parquet_extension",
        ":parquet_extension_init",
        ":autocomplete_extension",
        ":icu_extension",
        ":json_extension",
        ":tpch_extension",
        ":tpcds_extension",
        ":third_party_core",
        ":third_party_fsst",
        ":third_party_mbedtls",
        ":third_party_re2",
        ":extension_loader",
        ":generated_extension_loader",
        ":duckdb_linenoise",
        ":duckdb_static",
    ],
)

cc_binary(
    name = "duckdb_platform_binary",
    srcs = glob(
        ["tools/utils/**/*.cpp"],
        exclude = ["tools/utils/plan_serializer.cpp"],
    ),
    local_defines = DUCKDB_DEFINES,
