"""Bazel build for DuckDB, generated from the CMake action model.

The CMake build fans the sources out over ~190 object libraries, but those
compile under only 23 distinct (defines, includes, flags) profiles, so each
profile becomes one cc_library here. Compile parity is checked against the
per-source flags, not the grouping, so this is grouping-agnostic by design.

Toolchain-level flags (-std, -Wthread-safety, -mcpu, -DNDEBUG) live in
.bazelrc under --config=macos, mirroring the CMake Release configure.
"""

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library", "cc_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":duckdb_build_config.bzl", "DUCKDB_DEFINES", "DUCKDB_INCLUDES",
      "DUCKDB_TEST_INCLUDES", "duckdb_library")
load(":duckdb_codegen.bzl", "extension_codegen_files", "fixture_tree",
      "version_info_header")
load(":duckdb_test.bzl", "FIXTURE_TREES", "TEST_DATA_GLOBS",
      "TEST_DATA_GLOBS_WITHOUT_FIXTURES", "subdirectory_test",
      "sql_logic_test_list")

# --- configure_file() equivalents -------------------------------------------

extension_codegen_files(
    name = "generated_extension_codegen",
    extensions = [
        "core_functions",
        "parquet",
    ],
    header_out = "generated_extension_headers.hpp",
    loader_out = "generated_extension_loader.cpp",
)

filegroup(
    name = "generated_extension_headers_files",
    srcs = [":generated_extension_codegen"],
    output_group = "generated_extension_headers",
)

filegroup(
    name = "generated_extension_loader_files",
    srcs = [":generated_extension_codegen"],
    output_group = "generated_extension_loader",
)

cc_library(
    name = "generated_extension_headers",
    hdrs = [":generated_extension_headers_files"],
    includes = ["codegen"],
    deps = [":duckdb_headers"],
)

duckdb_library(
    name = "generated_extension_loader",
    srcs = [":generated_extension_loader_files"],
    local_defines = DUCKDB_DEFINES,
    deps = [":duckdb_headers", ":generated_extension_headers"],
)

# --- headers ---------------------------------------------------------------

# Every header is declared once so the C++ layering check can attribute each
# inclusion to a target.
cc_library(
    name = "duckdb_headers",
    hdrs = glob(
        [
            "src/include/**/*.h",
            "src/include/**/*.hpp",
            "extension/**/*.hpp",
            "third_party/**/*.h",
            "third_party/**/*.hpp",
            "third_party/**/*.tcc",
            "tools/**/*.h",
            "tools/**/*.hpp",
            "test/**/*.h",
            "test/**/*.hpp",
        ],
    ),
    textual_hdrs = [
        "third_party/utf8proc/utf8proc_data.cpp",
    ],
)

