"""Bazel build for DuckDB, generated from the CMake action model.

The CMake build fans the sources out over ~190 object libraries, but those
compile under only 18 distinct (defines, includes, flags) profiles, so each
profile becomes one cc_library here. Compile parity is checked against the
per-source flags, not the grouping, so this is grouping-agnostic by design.

Toolchain-level flags (-std, -Wthread-safety, -mcpu, -DNDEBUG) live in
.bazelrc under --config=macos, mirroring the CMake Release configure.
"""

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")
load(":duckdb_codegen.bzl", "extension_codegen_files")

# --- configure_file() equivalents -------------------------------------------

extension_codegen_files(
    name = "generated_extension_codegen",
    extensions = [
        "core_functions",
        "parquet",
    ],
    header_out = "generated_extension_headers.hpp",
    loader_out = "generated_extension_loader.cpp",
)

filegroup(
    name = "generated_extension_headers_files",
    srcs = [":generated_extension_codegen"],
    output_group = "generated_extension_headers",
)

filegroup(
    name = "generated_extension_loader_files",
    srcs = [":generated_extension_codegen"],
    output_group = "generated_extension_loader",
)

cc_library(
    name = "generated_extension_headers",
    hdrs = [":generated_extension_headers_files"],
    includes = ["codegen"],
    deps = [":duckdb_headers"],
)

cc_library(
    name = "generated_extension_loader",
    srcs = [
        ":generated_extension_loader_files",
    ],
    local_defines = [
        "DUCKDB_BUILD_LIBRARY",
        "DUCKDB_EXTENSION_CORE_FUNCTIONS_LINKED=1",
        "DUCKDB_EXTENSION_PARQUET_LINKED=1",
        "DUCKDB_MAJOR_VERSION=2",
        "DUCKDB_MINOR_VERSION=0",
        "DUCKDB_PATCH_VERSION=0",
        "GENERATED_EXTENSION_HEADERS=1",
    ],
    copts = [
        "-fPIC",
    ],
    includes = [
        "src/include",
        "third_party/fsst",
        "third_party/fmt/include",
        "third_party/hyperloglog",
        "third_party/fastpforlib",
        "third_party/skiplist",
        "third_party/ska_sort",
        "third_party/fast_float",
        "third_party/re2",
        "third_party/miniz",
        "third_party/utf8proc/include",
        "third_party/concurrentqueue",
        "third_party/pcg",
        "third_party/pdqsort",
        "third_party/tdigest",
        "third_party/mbedtls/include",
        "third_party/httplib",
        "third_party/jaro_winkler",
        "third_party/vergesort",
        "third_party/yyjson/include",
        "third_party/zstd/include",
        "codegen",
        "extension",
        "extension/core_functions/include",
        "extension/parquet/include",
    ],
    deps = [
        ":duckdb_headers",
        ":generated_extension_headers",
    ],
    alwayslink = 1,
)

# --- headers ---------------------------------------------------------------

# Every header is declared once so the C++ layering check can attribute each
# inclusion to a target.
cc_library(
    name = "duckdb_headers",
    hdrs = glob(
        [
            "src/include/**/*.h",
            "src/include/**/*.hpp",
            "src/include/**/*.tcc",
            "extension/**/*.h",
            "extension/**/*.hpp",
            "third_party/**/*.h",
            "third_party/**/*.hpp",
            "third_party/**/*.hh",
            "third_party/**/*.hxx",
            "third_party/**/*.inc",
            "third_party/**/*.inl",
            "third_party/**/*.tcc",
            "third_party/**/*.ipp",
            "third_party/**/*.def",
            "tools/**/*.h",
            "tools/**/*.hpp",
            "tools/**/*.hh",
        ],
        allow_empty = True,
    ),
    textual_hdrs = [
        "third_party/utf8proc/utf8proc_data.cpp",
    ],
)

