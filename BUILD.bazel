    name = "unittest_harness",
    srcs = glob(["test/*.cpp"]),
    local_defines = sorted(DUCKDB_DEFINES + ["DUCKDB_ROOT_DIRECTORY=\\\".\\\"", "DUCKDB_UNITTEST_CRASH_STACKTRACE"]),
    copts = ["-fPIC", "-fPIE"],
