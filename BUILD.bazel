    deps = [
        ":duckdb_headers",
        ":generated_extension_loader",
        ":test_helpers",
        "//test/sqlite:test_sqlite_libs",
        ":duckdb_static",
        ":duckdb_cpp_api",
        "//test/extension:debug_fs_libs",
