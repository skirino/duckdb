# --- benchmark runner --------------------------------------------------------

# The benchmark runner reads its fixtures out of the tree, so the benchmark
# directories are data rather than build inputs: they hold .test and .csv files
# the runner globs at run time.
BENCHMARK_DATA_GLOBS = [
    "benchmark/**",
    "data/**",
    "third_party/**",
]

filegroup(
    name = "benchmark_data",
    srcs = glob(BENCHMARK_DATA_GLOBS),
)

cc_library(
    name = "benchmark_headers",
    hdrs = glob(["benchmark/include/*.hpp"]),
    includes = ["benchmark/include"],
    deps = [":duckdb_headers"],
)

duckdb_library(
    name = "third_party_imdb",
    srcs = ["third_party/imdb/imdb.cpp"],
    copts = ["-fPIC", "-w"],
    # imdb.cpp spells its first include as "include/imdb.hpp" and its second as
    # the bare header name, so both roots are needed.
    includes = sorted(DUCKDB_INCLUDES + [
        "third_party/imdb",
        "third_party/imdb/include",
    ]),
)

duckdb_library(
    name = "benchmark_micro",
