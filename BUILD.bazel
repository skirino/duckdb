)

# The test harness every target links: Catch2's main, the helpers and the
# sqllogictest engine. The engine statically loads DebugFsExtension, so the
# extension libraries are here too.
duckdb_library(
    name = "unittest_harness",
    srcs = glob(["test/*.cpp"]),
    local_defines = DUCKDB_DEFINES + ["DUCKDB_ROOT_DIRECTORY=\\\".\\\"", "DUCKDB_UNITTEST_CRASH_STACKTRACE"],
    copts = ["-fPIC", "-fPIE"],
