# --- jemalloc ----------------------------------------------------------------

# An alternative allocator. jemalloc reaches malloc through its own exported
# symbols rather than by overriding new/delete, so linking it is a link-time
# choice -- which is what the build setting below selects. Nothing in src/ has
# to know about it except the allocator's own backend, which is gated on
# DUCKDB_ENABLE_JEMALLOC.
#
# Every target here is `manual`, so `bazel build //...` does not pay for the ~200
# jemalloc translation units and the second shell link on a build that does not
# use them. `bazel build --//:use_jemalloc=true //:jemalloc_shell` is what asks
# for it; a manual target is still built when something else needs it.
bool_flag(
    name = "use_jemalloc",
    build_setting_default = False,
)

config_setting(
    name = "jemalloc_enabled",
    flag_values = {"//:use_jemalloc": "true"},
)

cc_library(
    name = "jemalloc_lib",
    srcs = glob(["third_party/jemalloc/src/*.c"]),
    # jemalloc's own private headers live beside its sources in include/ and are
    # included by bare name, so they have to be declared or the sandboxed
    # compile cannot see them. jemalloc_preamble.h reaches back out of
    # internal/ with a relative "../", which is why the public headers are here
    # too and why the include root is the directory holding internal/.
    hdrs = glob(
        [
            "third_party/jemalloc/include/duckdb/*.h",
            "third_party/jemalloc/include/jemalloc/*.h",
            "third_party/jemalloc/include/jemalloc/internal/*.h",
        ],
    ),
    # alwayslink is Bazel's --whole-archive: jemalloc's malloc replacement is
    # only reachable if its object files survive the link, and a linker would
    # otherwise drop them as unreferenced.
    alwayslink = 1,
    copts = ["-w"],
    # jemalloc_preamble.h reaches back out of internal/ with a relative "../",
    # so the include root has to be the directory holding internal/, not
    # internal/ itself.
    includes = [
        "third_party/jemalloc/include",
        "third_party/jemalloc/include/jemalloc",
    ],
    tags = ["manual"],
)

duckdb_library(
    name = "duckdb_jemalloc_allocator",
    srcs = ["src/common/allocator/allocator_jemalloc.cpp"],
    local_defines = DUCKDB_DEFINES + [
        "DUCKDB_ENABLE_JEMALLOC",
        "DUCKDB_JEMALLOC_DECAY=1000",
    ],
    includes = sorted(DUCKDB_INCLUDES + ["third_party/jemalloc/include"]),
    deps = DUCKDB_LIB_DEPS + [":duckdb_allocator", ":jemalloc_lib"],
    tags = ["manual"],
)

cc_library(
    name = "jemalloc",
    deps = select({
        ":jemalloc_enabled": [":duckdb_jemalloc_allocator"],
        "//conditions:default": [],
    }),
    tags = ["manual"],
)

cc_binary(
    name = "jemalloc_shell",
    srcs = glob(["tools/shell/*.cpp"]),
    local_defines = DUCKDB_DEFINES + [
        "HAVE_LINENOISE=1",
        "USE_DUCKDB_SHELL_WRAPPER",
    ],
    copts = ["-fPIE"],
    includes = sorted(DUCKDB_INCLUDES + [
        "third_party/jemalloc/include",
        "tools/shell/include",
        "tools/shell/linenoise/include",
    ]),
    linkopts = [
        "-Wl,-search_paths_first",
        "-Wl,-headerpad_max_install_names",
    ],
    tags = ["manual"],
    deps = [
        ":duckdb_core",
        ":duckdb_catalog",
        ":duckdb_main_extension",
        ":duckdb_common_http",
        ":duckdb_func_table_version",
        ":core_functions",
        ":core_functions_extension_init",
        ":parquet_extension",
        ":parquet_extension_init",
        ":autocomplete_extension",
        ":icu_extension",
        ":json_extension",
        ":tpch_extension",
        ":tpcds_extension",
        ":third_party_core",
        ":third_party_fsst",
        ":third_party_mbedtls",
        ":third_party_re2",
        ":extension_loader",
        ":generated_extension_loader",
        ":duckdb_linenoise",
        ":jemalloc",
        ":duckdb_static",
    ],
)

# Each of these is its own .duckdb_extension shared library, and the tests LOAD
# them by that exact path under test/extension/. cc_shared_library keeps them
# library-kind, and the genrule then places the artifact in the runfiles where
# the test looks for it.
# The loader reads the metadata footer off the end of the file, so the artifact
# needs one; scripts/append_extension_metadata.py appends it.
genrule(
    name = "duckdb_platform_out",
    srcs = [":duckdb_platform_binary"],
    outs = ["duckdb_platform_out.txt"],
    cmd = "$(location :duckdb_platform_binary) > $@",
)

filegroup(
    name = "test_data",
    srcs = glob(TEST_DATA_GLOBS),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "test_data_without_fixtures",
    srcs = glob(TEST_DATA_GLOBS_WITHOUT_FIXTURES),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "test_extension_artifacts",
    srcs = [
        "//test/extension:cpp_api_demo_loadable_extension_file",
        "//test/extension:cpp_api_demo_fail_loadable_extension_file",
        "//test/extension:demo_capi_extension_file",
        "//test/extension:explicit_extension_schema_loadable_extension_file",
        "//test/extension:explicit_extension_schema_alias_loadable_extension_file",
        "//test/extension:loadable_extension_demo_loadable_extension_file",
        "//test/extension:loadable_extension_demo_double_loadable_extension_file",
        "//test/extension:loadable_extension_optimizer_demo_loadable_extension_file",
        "//test/extension:loadable_grammar_extension_demo_loadable_extension_file",
    ],
    visibility = ["//visibility:public"],
)

# # --- one cc_test per directory -------------------------------------------
#
# # A directory's .test files and its C++ TEST_CASEs cannot share a binary:
# # `-f` clears the whole Catch2 registry (test/unittest.cpp) and registers only
# # the listed files, so the two halves get their own targets per directory:
# #   <slug>_test         -f <its .test>       -> its non-hidden corpus
# #   <slug>_slow_test     -f <its .test_slow>  -> its hidden corpus
# #   <slug>_cpp_test      ~*.test ...        -> its C++ cases
# #   <slug>_cpp_slow_test [.] ~*.test ...    -> its hidden C++ cases
#
# # Corpus is split by an exact file list rather than a `prefix*` Catch2 pattern,
# # which cannot exclude .test_slow. The C++ targets drop the corpus by extension
# # instead (CPP_ONLY_ARGS below): a trailing `*` in a Catch2 pattern means
# # startsWith and a leading one means endsWith, so `~*.test` is the exclusion
# # that reads. `~test/*` would also drop the registered-by-hand cases such as
# # test/ossfuzz/cases/clusterfuzz-test-N, which are not .test files.
